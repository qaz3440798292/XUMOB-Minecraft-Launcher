{
  "name": "xumob-minecraft-launcher",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build --no-bundle",
    "format": "prettier --write src public index.html vite.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src public index.html vite.config.js package.json .prettierrc.json",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "dompurify": "^3.4.17",
    "markdown-it": "^14.3.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "vite": "8.3.4"
  }
}
